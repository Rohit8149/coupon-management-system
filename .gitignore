# Compiled Java class files and build targets
*.class
target/
app/target/
**/target/

# Package formats
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven wrapper binaries
.mvn/wrapper/maven-wrapper.jar
app/.mvn/wrapper/maven-wrapper.jar

# Application & container log files
*.log
logs/
app/logs/

# Test screenshots and failure artifacts
screenshots/failures/
app/screenshots/failures/
**/screenshots/failures/

# Document previous/archived versions and Word temporary lock files
docs/prev/
docs/*_draft_*.docx
docs/*_prev_*.docx
~$*
**/~$*

# Python virtual environment, bytecode, and caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# IDE and Editor configurations
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Internal lab documentation, automation scripts, and planning (kept local at root)
/docs/
/scripts/
/templates/
/planning/
/screenshots/
/.agents/
/GEMINI.md
